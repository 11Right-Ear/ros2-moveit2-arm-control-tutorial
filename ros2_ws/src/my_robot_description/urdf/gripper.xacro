<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 夹爪底座 -->
  <link name="gripper_base_link">
    <visual>
      <geometry>
        <box size="0.20 0.06 0.02"/>
      </geometry>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <material name="dark_green"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.20 0.06 0.02"/>
      </geometry>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000067" ixy="0" ixz="0" iyy="0.000673" iyz="0" izz="0.000727"/>
    </inertial>
  </link>

  <!-- 左夹爪手指 -->
  <link name="gripper_left_finger_link">
    <visual>
      <geometry>
        <box size="0.02 0.06 0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="light_green"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.02 0.06 0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000067" ixy="0" ixz="0" iyy="0.000045" iyz="0" izz="0.000027"/>
    </inertial>
  </link>

  <!-- 右夹爪手指 -->
  <link name="gripper_right_finger_link">
    <visual>
      <geometry>
        <box size="0.02 0.06 0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="light_green"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.02 0.06 0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000067" ixy="0" ixz="0" iyy="0.000045" iyz="0" izz="0.000027"/>
    </inertial>
  </link>

  <!-- 左手指连接到底座（prismatic，axis=+x，0=张开 0.06=闭合）。
       damping 给一点阻尼，避免这节低质量滑动关节在位置控制下抖动。 -->
  <joint name="gripper_left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_left_finger_link"/>
    <origin xyz="-0.07 0 0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="1.0"/>
    <limit effort="1000.0" velocity="1.0" lower="0.0" upper="0.06"/>
  </joint>

  <!-- 右手指连接到底座：mimic 联动左手指，multiplier=-1.0 表示反向，
       左手指动多少它就反向动多少，两指对向开合。右手指只做从动，
       不放进 ros2_control，由 Gazebo 物理引擎按 mimic 关系自动跟随。 -->
  <joint name="gripper_right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_right_finger_link"/>
    <origin xyz="0.07 0 0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <mimic joint="gripper_left_finger_joint" multiplier="-1.0"/>
    <limit effort="1000.0" velocity="1.0" lower="-0.06" upper="0.0"/>
  </joint>

</robot>