<?xml version="1.0"?>
<robot name="car" xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- 根 link：地面点，z=0 -->
    <link name="base_footprint"/>

    <!-- 把 base_link 抬到 z=0.55，让轮子底部正好落在地面 -->
    <joint name="base_footprint_to_base" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.55" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="2 1 0.5"/></geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="2 1 0.5"/></geometry>
        </collision>
    </link>

    <xacro:macro name="wheel" params="name x y">
        <link name="${name}_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <geometry><cylinder radius="0.3" length="0.2"/></geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <geometry><cylinder radius="0.3" length="0.2"/></geometry>
            </collision>
        </link>

        <joint name="base_to_${name}" type="continuous">
            <parent link="base_link"/>
            <child link="${name}_link"/>
            <origin xyz="${x} ${y} -0.25" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>

    <xacro:wheel name="front_left"  x="0.8"  y="0.6"/>
    <xacro:wheel name="front_right" x="0.8"  y="-0.6"/>
    <xacro:wheel name="rear_left"   x="-0.8" y="0.6"/>
    <xacro:wheel name="rear_right"  x="-0.8" y="-0.6"/>

</robot>
<gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <update_rate>50</update_rate>

        <left_joint>base_to_front_left</left_joint>
        <left_joint>base_to_rear_left</left_joint>
        <right_joint>base_to_front_right</right_joint>
        <right_joint>base_to_rear_right</right_joint>

        <wheel_separation>1.2</wheel_separation>
        <wheel_radius>0.3</wheel_radius>

        <command_topic>cmd_vel</command_topic>
        <odometry_topic>odom</odometry_topic>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
</gazebo>