<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gazebo 物理仿真专用 ros2_control 硬件接口（区别于 mock 版
    my_robot.ros2_control.xacro）：
    1) 硬件插件换成 gazebo_ros2_control/GazeboSystem，由 Gazebo 物理引擎驱动；
    2) 每个关节的 position 命令接口通过 pos_kp/pos_kd 声明 PID 增益，
       gazebo_ros2_control 会据此把位置误差换算成力矩作用到关节上（真实物理）。
       这里刻意去掉 pos_ki（积分项），避免 windup 导致臂发散；kd 加大 + URDF 里
       的关节 dynamics damping 一起提供阻尼，防止振荡。
    3) 显式给出 initial_value，避免状态初值为 NaN 导致仿真发散；
    4) <gazebo> 插件块 libgazebo_ros2_control.so 在模型加载时创建
       controller_manager 并加载控制器参数 yaml。
  -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint1">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint2">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint3">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint4">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint5">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint6">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

  </ros2_control>

  <!-- Gazebo 加载该插件，创建 controller_manager 并读取控制器参数。
       hold_joints=true：控制器尚未激活时把关节速度锁为 0，
       避免机械臂在启动最初几秒因重力自由下落而折断塌陷。 -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find my_robot_bringup)/config/ros2_controllers_gazebo.yaml</parameters>
      <hold_joints>true</hold_joints>
    </plugin>
  </gazebo>

  <!-- 关闭相邻连杆之间的碰撞。
       本 URDF 里每一段的碰撞盒都"正好贴着"下一段（面面共面，X/Y 完全重叠），
       这种零穿透的退化接触会让 ODE 的约束求解器解出 NaN：
       关节 velocity/effort 变成 NaN，连杆位姿变成 NaN，
       Gazebo 渲染时 NaN 位姿的连杆直接不显示 —— 表现就是"只剩底座，机械臂不见了"。
       机器人自身的相邻连杆本来就不该互相碰撞，关掉同时也避免
       碰撞求解器跟关节 PID 抢力矩（机械臂会抖、会飞）。 -->
  <gazebo>
    <joint name="joint1">
      <parent>base_link</parent>
      <child>shoulder_link</child>
      <disable_collide>true</disable_collide>
    </joint>
    <joint name="joint2">
      <parent>shoulder_link</parent>
      <child>arm_link</child>
      <disable_collide>true</disable_collide>
    </joint>
    <joint name="joint3">
      <parent>arm_link</parent>
      <child>elbow_link</child>
      <disable_collide>true</disable_collide>
    </joint>
    <joint name="joint4">
      <parent>elbow_link</parent>
      <child>forearm_link</child>
      <disable_collide>true</disable_collide>
    </joint>
    <joint name="joint5">
      <parent>forearm_link</parent>
      <child>wrist_link</child>
      <disable_collide>true</disable_collide>
    </joint>
    <joint name="joint6">
      <parent>wrist_link</parent>
      <child>hand_link</child>
      <disable_collide>true</disable_collide>
    </joint>
  </gazebo>

</robot>