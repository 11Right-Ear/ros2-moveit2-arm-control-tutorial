<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gazebo 物理仿真专用 ros2_control 硬件接口（区别于 mock 版
    my_robot.ros2_control.xacro）：
    1) 硬件插件换成 gazebo_ros2_control/GazeboSystem，由 Gazebo 物理引擎驱动；
    2) 每个关节的 position 命令接口通过 pos_kp/pos_kd 声明 PID 增益，
       gazebo_ros2_control 会据此把位置误差换算成力矩作用到关节上（真实物理）。
       这里刻意去掉 pos_ki（积分项），避免 windup 导致臂发散；kd 加大 + URDF 里
       的关节 dynamics damping 一起提供阻尼，防止振荡。
    3) 显式给出 initial_value，避免状态初值为 NaN 导致仿真发散；
    4) <gazebo> 插件块 libgazebo_ros2_control.so 在模型加载时创建
       controller_manager 并加载控制器参数 yaml。
  -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint1">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint2">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint3">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint4">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint5">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint6">
      <param name="pos_kp">80.0</param>
      <param name="pos_kd">15.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

  </ros2_control>

  <!-- Gazebo 加载该插件，创建 controller_manager 并读取控制器参数。
       hold_joints=true：控制器尚未激活时把关节速度锁为 0，
       避免机械臂在启动最初几秒因重力自由下落而折断塌陷。 -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find my_robot_bringup)/config/ros2_controllers_gazebo.yaml</parameters>
      <hold_joints>true</hold_joints>
    </plugin>
  </gazebo>

  <!--
    注意：不要在这里加 <gazebo><joint>...<disable_collide> 的写法。
    Gazebo 把 URDF 读进来时会把它当成真正的 SDF <joint> 处理，而
    disable_collide 那种写法没有 type 属性，结果是整个模型解析失败：
      Error Code 4 Msg: Required attribute[type] in element[joint] is not specified in SDF.
    相邻连杆的碰撞改用 arm.xacro 里的碰撞盒留缝（每段比原来短 1cm）来避免。
  -->

</robot>